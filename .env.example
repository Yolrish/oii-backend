


# ==================== MongoDB 配置 ====================
# 连接 URI，例如 mongodb://localhost:27017 或 mongodb+srv://...
MONGO_DATABASE_URL=mongodb://localhost:27017
# 默认数据库名
MONGO_DATABASE_NAME=ai_backend


# ==================== Workflow 持久化配置 ====================
# 是否启用工作流持久化（true/false），启用时需在创建 WorkflowService 时注入 db
WORKFLOW_PERSIST_ENABLED=true
# 存储工作流的 MongoDB 集合名
WORKFLOW_COLLECTION_NAME=workflows
# 可选：step 超时（秒）、task 超时、step 内 task 并发上限
# WORKFLOW_STEP_TIMEOUT=0
# WORKFLOW_TASK_TIMEOUT=0
# WORKFLOW_MAX_TASK_CONCURRENT=0


# ==================== LOG服务 OpenSearch 配置 ====================
# OpenSearch 服务地址
OPENSEARCH_HOST=
# 认证用户名
OPENSEARCH_USERNAME=
# 认证密码
OPENSEARCH_PASSWORD=
# 是否使用 SSL（true/false）
OPENSEARCH_USE_SSL=
# 是否验证 SSL 证书（true/false）
# 自签名证书设为 false
OPENSEARCH_VERIFY_CERTS=
# 默认索引名称
OPENSEARCH_INDEX_NAME=



# ==================== Claude 对话模块配置 ====================
# Anthropic API Key（必填）
CLAUDE_API_KEY=
# 模型名称
CLAUDE_MODEL=claude-sonnet-4-20250514
# 最大输出 token
# CLAUDE_MAX_TOKENS=4096
# 温度（0.0~1.0）
# CLAUDE_TEMPERATURE=0.7
# 系统提示词
# CLAUDE_SYSTEM_PROMPT=
# Tool calling 最大循环轮数
# CLAUDE_MAX_TOOL_ROUNDS=10
# 请求超时（秒）
# CLAUDE_TIMEOUT=120
# 自定义 API 地址（代理场景）
# CLAUDE_BASE_URL=


# ==================== Chat 会话管理配置 ====================
# MongoDB 集合名
# CHAT_SESSION_COLLECTION=chat_sessions
# CHAT_MESSAGE_COLLECTION=chat_messages
# 内存 LRU 缓存大小（缓存多少个活跃 session）
# CHAT_CACHE_SIZE=50
# 上下文 token 上限，超出时自动截断最早的消息
# CHAT_MAX_CONTEXT_TOKENS=100000


# ==================== Auth0 用户系统配置 ====================
# Auth0 租户域名
AUTH0_DOMAIN=your-tenant.auth0.com
# API Audience
AUTH0_AUDIENCE=https://your-api.example.com
# Auth0 应用 Client ID
AUTH0_CLIENT_ID=
# Token 签名算法
# AUTH0_ALGORITHMS=RS256
# Token 时间容差（秒），用于兼容时钟偏差，默认 5
# AUTH0_TOKEN_LEEWAY=5
# 用户集合名
# AUTH_USER_COLLECTION=users


# ==================== Prompt 管理配置 ====================
# MongoDB 集合名
# PROMPT_COLLECTION=prompts


# ==================== Twitter/X API 配置 ====================
# 在 https://developer.x.com/portal 创建应用后获取
# OAuth 1.0a 凭据（用户上下文操作：发推、点赞等）
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Bearer Token（应用级只读操作：搜索、查询用户等）
TWITTER_BEARER_TOKEN=
# 可选配置
# TWITTER_BASE_URL=https://api.twitter.com/2
# TWITTER_TIMEOUT=30


# ==================== FFMPEG 配置 ====================
# 生成文件的临时输出目录，为空时会使用系统临时目录 tempfile.gettempdir()
# 在 Windows 上通常是 C:\Users\xxx\AppData\Local\Temp
# 在 Linux 上通常是 /tmp
FFMPEG_TEMP_DIR=