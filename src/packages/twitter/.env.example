# ==================== Twitter/X API 配置 ====================
# 在 https://developer.x.com/portal 创建应用后获取

# OAuth 1.0a 凭据（用于用户上下文操作：发推、点赞、转推等）
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Bearer Token（用于应用级只读操作：搜索、查询用户等）
TWITTER_BEARER_TOKEN=

# 可选：API 基础地址（默认 https://api.twitter.com/2）
# TWITTER_BASE_URL=https://api.twitter.com/2

# 可选：请求超时（秒，默认 30）
# TWITTER_TIMEOUT=30
